"use strict";
document.addEventListener("click", function(e) {
    if (e.target.closest(".wall")) {
        var wallJ = document.querySelector(".wall");
        var wallWidth = wallJ.clientWidth;
        var wallHeight = wallJ.clientHeight;
        var wallRect = wallJ.getBoundingClientRect();
        var wallTopCoord = wallRect.y + wallJ.clientTop;
        var wallLeftCoord = wallRect.x + wallJ.clientLeft;
        var spiderJ = document.querySelector(".spider");
        var spiderWidth = spiderJ.clientWidth;
        var spiderHeight = spiderJ.clientHeight;
        var newTopCoord = e.clientY - spiderHeight / 2;
        var newLeftCoord = e.clientX - spiderWidth / 2;
        if (newTopCoord < wallTopCoord) newTopCoord = 0;
        else if (newTopCoord + spiderHeight > wallTopCoord + wallHeight) newTopCoord = wallHeight - spiderHeight;
        else newTopCoord = newTopCoord - wallTopCoord;
        if (newLeftCoord < wallLeftCoord) newLeftCoord = 0;
        else if (newLeftCoord + spiderWidth > wallLeftCoord + wallWidth) newLeftCoord = wallWidth - spiderWidth;
        else newLeftCoord = newLeftCoord - wallLeftCoord;
        spiderJ.style.top = newTopCoord + "px";
        spiderJ.style.left = newLeftCoord + "px";
    }
});

